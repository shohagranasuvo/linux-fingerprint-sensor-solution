# Goodix GM168 Biometric Sensors (Xiaomi RedmiBook Pro 14S / 15, Mi NoteBook Ultra)
# USB Product IDs: 27c6:581a, 27c6:589a
SUBSYSTEM=="usb", ATTRS{idVendor}=="27c6", ATTRS{idProduct}=="581a", MODE="0666", TAG+="uaccess", TEST=="power/control", ATTR{power/control}="on", TEST=="power/autosuspend", ATTR{power/autosuspend}="-1", TEST=="power/persist", ATTR{power/persist}="1"
SUBSYSTEM=="usb", ATTRS{idVendor}=="27c6", ATTRS{idProduct}=="589a", MODE="0666", TAG+="uaccess", TEST=="power/control", ATTR{power/control}="on", TEST=="power/autosuspend", ATTR{power/autosuspend}="-1", TEST=="power/persist", ATTR{power/persist}="1"
